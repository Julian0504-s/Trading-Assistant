# Kopie als .env anlegen. Phase 1 braucht KEINE API-Keys.

# Komma-getrennte Watchlist (Bitunix-Symbolnamen)
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,ADAUSDT,LINKUSDT,ZECUSDT,AVAXUSDT

# Komma-getrennte Timeframes (3m ist nicht offiziell dokumentiert, funktioniert aber)
TIMEFRAMES=1m,3m,5m,15m,1h,4h,1d

# Pfad zur SQLite-Datenbank
DB_PATH=data/market.db

# Schwelle für "extreme Funding Rate" pro 8h als Bruch (0.0005 = 0,05 %).
# Normal sind ca. ±0,01 %. Wird auf das Funding-Intervall des Kontrakts umgerechnet.
FUNDING_EXTREME_PER_8H=0.0005

# --- Telegram-Alerts (optional) ---
# Bot bei @BotFather anlegen -> Token. Dem Bot einmal schreiben, dann die Chat-ID über
# https://api.telegram.org/bot<TOKEN>/getUpdates ablesen ("chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Nur Signale ab dieser Stärke melden (1 = schwach, 2 = mittel, 3 = stark)
ALERT_MIN_STRENGTH=2
# Nur diese Timeframes melden (leer = alle), z. B. 15m,1h,4h,1d,funding
ALERT_TIMEFRAMES=
# Gleiche Kombination (Symbol, Timeframe, Regel, Richtung) frühestens nach N Minuten erneut
ALERT_COOLDOWN_MIN=60

# --- Phase 3: Backtest & Paper Trading ---
# Pflicht: true. Live-Trading gibt es erst in Phase 4; bei false bricht der Bot ab.
DRY_RUN=true
# Paper-Konten als strategie@timeframe (Strategien: trend, all_medium, strong)
PAPER_RUNS=trend_trail@1d,trend@1d
PAPER_CAPITAL=1000
# Existiert diese Datei, schließt der Bot alle Positionen und hält an
KILL_SWITCH_FILE=KILL_SWITCH
